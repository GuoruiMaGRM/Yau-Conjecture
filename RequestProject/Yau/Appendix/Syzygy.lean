import RequestProject.Yau.CommAlg.RegularSequence

/-!
# Regular sequences of partial derivatives and Lemma B.1

The partial derivatives of an isolated weighted homogeneous singularity, with
positive weights and `w_i < d`, form a regular sequence in any order.
Consequently a homogeneous syzygy of degree `q < 2(d-W)` is zero, and expressions
of these degrees in terms of the partial derivatives have unique coefficients.
-/

open MvPolynomial RingTheory.Sequence

noncomputable section

namespace Yau

variable {n : ℕ} {w : Fin n → ℕ} {d : ℕ} {f : Poly n}

/-- The list of partial derivatives `[f₁,…,fₙ]`. -/
def partialsList (f : Poly n) : List (Poly n) := (List.finRange n).map fun i => pderiv i f

lemma ofList_partialsList_take (f : Poly n) (j : ℕ) :
    Ideal.ofList ((partialsList f).take j) =
      Ideal.span ((fun i => pderiv i f) '' {i : Fin n | (i : ℕ) < j}) := by
  rw [Ideal.ofList, partialsList, ← List.map_take]
  congr 1
  ext r
  simp only [Set.mem_setOf_eq, List.mem_map, Set.mem_image, mem_take_finRange_iff]

lemma ofList_eq_jacobianIdeal {gs : List (Poly n)} (hperm : gs.Perm (partialsList f)) :
    Ideal.ofList gs = jacobianIdeal f := by
  rw [Ideal.ofList, jacobianIdeal]
  congr 1
  ext r
  simp only [Set.mem_setOf_eq, hperm.mem_iff, partialsList, List.mem_map, List.mem_finRange,
    true_and, Set.mem_range]

/-- The full gradient is a regular sequence in any order for an isolated weighted homogeneous polynomial with positive weights and `w_i < d`. -/
theorem isWeaklyRegular_partials (hw : ∀ i, 0 < w i) (hf : f.IsWeightedHomogeneous w d)
    (hiso : IsIsolatedSingularity f) (hwd : ∀ i, w i < d) {gs : List (Poly n)}
    (hperm : gs.Perm (partialsList f)) : IsWeaklyRegular (Poly n) gs := by
  refine isWeaklyRegular_of_finite_quotient hw gs ?_ ?_ ?_
  · simp [hperm.length_eq, partialsList]
  · intro g hg
    rw [hperm.mem_iff, partialsList, List.mem_map] at hg
    obtain ⟨i, -, rfl⟩ := hg
    exact ⟨d - w i, by have := hwd i; omega, pderiv_f_isWH hf i⟩
  · rw [ofList_eq_jacobianIdeal hperm]; exact hiso

/-- A nonzero homogeneous element of an ideal generated in degrees at least `c` has degree at least `c`. -/
lemma le_degree_of_mem_ofList (l : List (Poly n))
    (hl : ∀ r ∈ l, ∃ e, c ≤ e ∧ r.IsWeightedHomogeneous w e) {b : Poly n} {m : ℕ}
    (hbm : b.IsWeightedHomogeneous w m) (hb0 : b ≠ 0) (hb : b ∈ Ideal.ofList l) : c ≤ m := by
  classical
  by_contra hlt
  push_neg at hlt
  apply hb0
  rw [← hbm.weightedHomogeneousComponent_same]
  rw [ofList_eq_span_range] at hb
  obtain ⟨coef, hcoef⟩ := Ideal.mem_span_range_iff_exists_fun.1 hb
  rw [← hcoef, map_sum]
  refine Finset.sum_eq_zero fun k _ => ?_
  obtain ⟨e, hce, he⟩ := hl l[k] (List.getElem_mem _)
  rw [weightedHomogeneousComponent_mul_of_right _ _ e m he, if_neg (by omega)]

/-- Lemma B.1: if `q < 2(d-W)`, `a_i` has degree `q-d+w_i`, and `∑ a_i f_i = 0`, then every `a_i` is zero. Negative-degree coefficients are taken to be zero. -/
theorem syzygy (hw : ∀ i, 0 < w i) (hf : f.IsWeightedHomogeneous w d)
    (hiso : IsIsolatedSingularity f) (hwd : ∀ i, w i < d) {W : ℕ} (hW : ∀ i, w i ≤ W)
    {q : ℕ} (hq : q < 2 * (d - W)) (a : Fin n → Poly n)
    (ha : ∀ i, (a i).IsWeightedHomogeneous w (q + w i - d))
    (ha0 : ∀ i, q + w i < d → a i = 0)
    (hsum : ∑ i, a i * pderiv i f = 0) : ∀ i, a i = 0 := by
  classical
  by_contra hne
  push_neg at hne
  set T : Finset (Fin n) := Finset.univ.filter fun i => a i ≠ 0 with hT
  have hTne : T.Nonempty := by
    obtain ⟨i, hi⟩ := hne
    exact ⟨i, by simp [hT, hi]⟩
  set j := T.max' hTne with hj
  have hjT : j ∈ T := T.max'_mem hTne
  have hj0 : a j ≠ 0 := by simpa [hT] using hjT
  have hgt : ∀ i, j < i → a i = 0 := by
    intro i hi
    by_contra h
    have : i ∈ T := by simp [hT, h]
    exact absurd (T.le_max' i this) (not_le.mpr hi)
  -- The product `a_j f_j` belongs to the ideal generated by the preceding partial derivatives.
  set I := Ideal.ofList ((partialsList f).take j) with hI
  have hmem : pderiv j f * a j ∈ I := by
    have hsplit : a j * pderiv j f = -∑ i ∈ Finset.univ.erase j, a i * pderiv i f := by
      rw [← Finset.add_sum_erase _ _ (Finset.mem_univ j)] at hsum
      exact eq_neg_of_add_eq_zero_left hsum
    rw [mul_comm, hsplit]
    refine I.neg_mem (I.sum_mem fun i hi => ?_)
    rcases lt_or_gt_of_ne (Finset.ne_of_mem_erase hi) with h | h
    · rw [hI, ofList_partialsList_take]
      exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, h, rfl⟩)
    · rw [hgt i h, zero_mul]; exact I.zero_mem
  -- Regularity gives `a_j ∈ I`.
  have hreg := isWeaklyRegular_partials hw hf hiso hwd (List.Perm.refl (partialsList f))
  rw [isWeaklyRegular_self_iff] at hreg
  have hjlen : (j : ℕ) < (partialsList f).length := by simp [partialsList]
  have haj : a j ∈ I := by
    refine hreg j hjlen (a j) ?_
    simpa [partialsList] using hmem
  -- Compare degrees.
  have hdeg := le_degree_of_mem_ofList (c := d - W) ((partialsList f).take j) (fun r hr => by
      obtain ⟨i, -, rfl⟩ := List.mem_map.1 (List.mem_of_mem_take hr)
      exact ⟨d - w i, by have := hW i; omega, pderiv_f_isWH hf i⟩) (ha j) hj0 haj
  have h1 : d ≤ q + w j := by
    by_contra h; exact hj0 (ha0 j (by omega))
  have := hW j
  omega

/-- Lemma B.1, uniqueness: two expressions in the partial derivatives with coefficients of degree `q-d+w_i`, where `q < 2(d-W)`, have identical coefficients. -/
theorem syzygy_unique (hw : ∀ i, 0 < w i) (hf : f.IsWeightedHomogeneous w d)
    (hiso : IsIsolatedSingularity f) (hwd : ∀ i, w i < d) {W : ℕ} (hW : ∀ i, w i ≤ W)
    {q : ℕ} (hq : q < 2 * (d - W)) (a b : Fin n → Poly n)
    (ha : ∀ i, (a i).IsWeightedHomogeneous w (q + w i - d))
    (ha0 : ∀ i, q + w i < d → a i = 0)
    (hb : ∀ i, (b i).IsWeightedHomogeneous w (q + w i - d))
    (hb0 : ∀ i, q + w i < d → b i = 0)
    (hab : ∑ i, a i * pderiv i f = ∑ i, b i * pderiv i f) : a = b := by
  have h := syzygy hw hf hiso hwd hW hq (a - b)
    (fun i => Submodule.sub_mem (weightedHomogeneousSubmodule ℂ w _) (ha i) (hb i))
    (fun i hi => by simp [ha0 i hi, hb0 i hi])
    (by simp only [Pi.sub_apply, sub_mul, Finset.sum_sub_distrib, hab, sub_self])
  funext i
  exact sub_eq_zero.1 (h i)

end Yau
