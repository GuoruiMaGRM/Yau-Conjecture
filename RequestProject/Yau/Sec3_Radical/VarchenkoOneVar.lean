import RequestProject.Yau.Versality.FixedPoint

/-!
# The `μ`-constant stratum in one variable

For `f=cx^ℓ`, the local Milnor number at a point is the multiplicity of that
point as a root of the derivative. Maximal multiplicity forces the derivative
of the monomial-basis deformation to be `ℓc(x-b)^{ℓ-1}`. Comparing coefficients
gives `b=0` and vanishing of the nonconstant parameters; critical value zero
also eliminates the constant parameter.
This proves the stratum statement directly in one variable, and reduces the
general stratum hypothesis to numbers of variables at least two.
-/

open MvPolynomial Filter Topology

noncomputable section

namespace Yau

/-- The stratum-inclusion hypothesis for a fixed number `n` of variables. -/
def VarchenkoTheoremFor (n : ℕ) : Prop :=
  ∀ (w : Fin n → ℕ) (d : ℕ) (f : Poly n), (∀ i, 0 < w i) →
    f.IsWeightedHomogeneous w d → HasIsolatedCriticalPoint f → eval 0 f = 0 →
    ∀ (μ : ℕ) (β : Fin μ → (Fin n →₀ ℕ)), IsMonomialBasis f β →
    ∃ ε > 0, ∀ (s : Fin μ → ℂ) (p : Fin n → ℂ), ‖s‖ < ε → ‖p‖ < ε →
      IsIsolatedCriticalPointAt (miniversalDeformation f β s) p →
      miniversalDeformation f β s p = 0 →
      localMilnorNumber (miniversalDeformation f β s) p =
        localMilnorNumber (fun x => eval x f) 0 →
      ∀ j, Finsupp.weight w (β j) < d → s j = 0

theorem varchenkoTheorem_iff : VarchenkoTheorem ↔ ∀ n, VarchenkoTheoremFor n := Iff.rfl

/-! ## One-variable polynomials -/

/-- `ℂ[x₀] ≅ ℂ[X]`。 -/
def toPoly1 : Poly 1 ≃ₐ[ℂ] Polynomial ℂ :=
  (renameEquiv ℂ (Equiv.equivPUnit.{1, 1} (Fin 1))).trans (pUnitAlgEquiv.{0, 0} ℂ)

@[simp] lemma toPoly1_X (i : Fin 1) : toPoly1 (X i) = Polynomial.X := by
  simp [toPoly1]

@[simp] lemma toPoly1_C (a : ℂ) : toPoly1 (C a) = Polynomial.C a := by
  simp [toPoly1]

lemma eval_eq_toPoly1_eval (R : Poly 1) (x : Fin 1 → ℂ) : eval x R = (toPoly1 R).eval (x 0) := by
  induction R using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp => simp [hp, Subsingleton.elim i 0]

lemma toPoly1_pderiv (R : Poly 1) : toPoly1 (pderiv 0 R) = Polynomial.derivative (toPoly1 R) := by
  induction R using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => simp [hp, hq]
  | mul_X p i hp => simp [hp, Subsingleton.elim i 0, Derivation.leibniz]; ring

/-- `dim ℂ[x₀]/(x₀^m) = m`。 -/
lemma finrank_quot_X_pow (m : ℕ) :
    Module.finrank ℂ (Poly 1 ⧸ Ideal.span {(X 0 : Poly 1) ^ m}) = m := by
  have hmap : (Ideal.span {(X 0 : Poly 1) ^ m}).map (toPoly1 : Poly 1 →+* Polynomial ℂ) =
      Ideal.span {Polynomial.X ^ m} := by
    rw [Ideal.map_span, Set.image_singleton]; simp
  let E := Ideal.quotientEquivAlg (Ideal.span {(X 0 : Poly 1) ^ m}) _ toPoly1 hmap.symm
  rw [E.toLinearEquiv.finrank_eq]
  have := (AdjoinRoot.powerBasis' (Polynomial.monic_X_pow (R := ℂ) m)).finrank
  rw [AdjoinRoot.powerBasis'_dim, Polynomial.natDegree_X_pow] at this
  exact this

/-- An analytic function with nonzero value at the base point has an invertible Taylor series in `ℂ{x}`. -/
lemma isUnit_taylorAt_eval {B : Poly 1} {p : Fin 1 → ℂ} (hB : eval p B ≠ 0) :
    IsUnit (taylorAt (fun x => eval x B) p) := by
  have hA : AnalyticAt ℂ (fun x => eval x B) p := analyticAt_eval B p
  have hI : AnalyticAt ℂ (fun x => (eval x B)⁻¹) p := hA.inv hB
  refine IsUnit.of_mul_eq_one (b := taylorAt (fun x => (eval x B)⁻¹) p) ?_
  rw [← taylorAt_mul hA hI]
  have hne : ∀ᶠ x in 𝓝 p, eval x B ≠ 0 := hA.continuousAt.eventually_ne hB
  rw [taylorAt_congr (h' := fun _ => (1 : ℂ)) (by
    filter_upwards [hne] with x hx; exact mul_inv_cancel₀ hx), taylorAt_const, map_one]

set_option synthInstance.maxHeartbeats 200000 in
/-- The codimension of the ideal generated by the Taylor series of a one-variable polynomial at `p` equals its root multiplicity at `p`. -/
lemma finrank_quot_taylorAt_eval {R : Poly 1} (hR : R ≠ 0) (p : Fin 1 → ℂ) :
    Module.finrank ℂ (ConvSeries 1 ⧸ Ideal.span {taylorAt (fun x => eval x R) p}) =
      Polynomial.rootMultiplicity (p 0) (toPoly1 R) := by
  set a := p 0
  set m := Polynomial.rootMultiplicity a (toPoly1 R)
  have hQ : toPoly1 R ≠ 0 := by simpa using hR
  obtain ⟨U, hU, hndvd⟩ := Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd _ hQ a
  set A : Poly 1 := (X 0 - C a) ^ m
  set B : Poly 1 := toPoly1.symm U
  have hRAB : R = A * B := by
    apply toPoly1.injective; simp only [A, B, map_mul, map_pow, map_sub, toPoly1_X, toPoly1_C,
      AlgEquiv.apply_symm_apply]; exact hU
  have hB : eval p B ≠ 0 := by
    rw [eval_eq_toPoly1_eval]; simp only [B, AlgEquiv.apply_symm_apply]
    intro h; exact hndvd (Polynomial.dvd_iff_isRoot.mpr h)
  have hTA : taylorAt (fun x => eval x A) p = polyToConv ((X 0 : Poly 1) ^ m) := by
    rw [← taylorAt_eval_zero]
    show taylorConv0 _ = taylorConv0 _
    congr 1; funext y; simp [A, a]
  have hT : taylorAt (fun x => eval x R) p =
      polyToConv ((X 0 : Poly 1) ^ m) * taylorAt (fun x => eval x B) p := by
    rw [← hTA, ← taylorAt_mul (analyticAt_eval A p) (analyticAt_eval B p)]
    congr 1; funext x; rw [hRAB, eval_mul]
  rw [hT, Ideal.span_singleton_mul_right_unit (isUnit_taylorAt_eval hB)]
  have hI : ∀ i, ∃ N : ℕ, (X i : Poly 1) ^ N ∈ Ideal.span {(X 0 : Poly 1) ^ m} := fun i =>
    ⟨m, by rw [Subsingleton.elim i 0]; exact Ideal.subset_span rfl⟩
  have hspan : Ideal.span {polyToConv ((X 0 : Poly 1) ^ m)} =
      convIdeal (Ideal.span {(X 0 : Poly 1) ^ m}) := by
    rw [convIdeal, Ideal.map_span, Set.image_singleton]
  rw [hspan, ← (quotientEquivConv hI).toLinearEquiv.finrank_eq, finrank_quot_X_pow]

set_option synthInstance.maxHeartbeats 200000 in
/-- The local Milnor number of a one-variable polynomial is the root multiplicity of its derivative, when that derivative is nonzero. -/
theorem localMilnorNumber_eval_one {P : Poly 1} (hP : pderiv 0 P ≠ 0) (p : Fin 1 → ℂ) :
    localMilnorNumber (fun x => eval x P) p =
      Polynomial.rootMultiplicity (p 0) (Polynomial.derivative (toPoly1 P)) := by
  have h1 : localJacobianIdeal (fun x => eval x P) p =
      Ideal.span {taylorAt (fun x => eval x (pderiv 0 P)) p} := by
    rw [localJacobianIdeal, Set.range_unique]
    simp [partialFun_eval, Subsingleton.elim (default : Fin 1) 0]
  rw [localMilnorNumber, h1, finrank_quot_taylorAt_eval hP, toPoly1_pderiv]

/-! ## One-variable weighted homogeneous polynomials -/

lemma finsupp_fin1 (m : Fin 1 →₀ ℕ) : m = Finsupp.single 0 (m 0) :=
  Finsupp.ext fun i => by fin_cases i; simp

/-- An isolated weighted homogeneous polynomial in one variable, vanishing at the origin, is `c x^ℓ` with `c≠0` and `ℓ≥2`. -/
lemma eq_C_mul_X_pow_of_isolated {w : Fin 1 → ℕ} {d : ℕ} {f : Poly 1} (hw : ∀ i, 0 < w i)
    (hf : f.IsWeightedHomogeneous w d) (hcrit : HasIsolatedCriticalPoint f) (h0 : eval 0 f = 0) :
    ∃ (c : ℂ) (ℓ : ℕ), c ≠ 0 ∧ 2 ≤ ℓ ∧ ℓ * w 0 = d ∧
      toPoly1 f = Polynomial.C c * Polynomial.X ^ ℓ := by
  have hf0 : f ≠ 0 := by
    rintro rfl
    obtain ⟨U, hU, hUc⟩ := hcrit.2
    obtain ⟨x, hxU, hx0⟩ := Filter.nonempty_of_mem (Filter.inter_mem (nhdsWithin_le_nhds hU)
      (self_mem_nhdsWithin : {0}ᶜ ∈ 𝓝[≠] (0 : Fin 1 → ℂ)))
    exact hx0 (hUc x hxU (by simp))
  set ℓ := d / w 0
  have hsupp : ∀ m, coeff m f ≠ 0 → m = Finsupp.single 0 ℓ := by
    intro m hm
    have h := hf hm
    rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (by simp)] at h
    simp only [Fin.sum_univ_one, smul_eq_mul] at h
    rw [finsupp_fin1 m]; congr 1
    show m 0 = d / w 0
    rw [← h, Nat.mul_div_cancel _ (hw 0)]
  set c := coeff (Finsupp.single 0 ℓ) f
  have hfeq : f = C c * X 0 ^ ℓ := by
    rw [C_mul_X_pow_eq_monomial]
    ext m
    rw [coeff_monomial]
    split_ifs with h
    · rw [← h]
    · by_contra hm; exact h (hsupp m hm).symm
  have hc : c ≠ 0 := by rintro hc; rw [hc, map_zero, zero_mul] at hfeq; exact hf0 hfeq
  have hP : toPoly1 f = Polynomial.C c * Polynomial.X ^ ℓ := by rw [hfeq]; simp
  have hℓd : ℓ * w 0 = d := by
    have h := hf (show coeff (Finsupp.single 0 ℓ) f ≠ 0 from hc)
    rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (by simp)] at h
    simpa using h
  refine ⟨c, ℓ, hc, ?_, hℓd, hP⟩
  by_contra hlt
  push_neg at hlt
  interval_cases hℓ : ℓ
  · apply hc; rw [eval_eq_toPoly1_eval, hP] at h0; simpa using h0
  · have := hcrit.1 0
    rw [eval_eq_toPoly1_eval, toPoly1_pderiv, hP] at this
    apply hc; simpa using this

/-- For `f=cx^ℓ`, the exponents in a monomial basis are distinct and all less than `ℓ-1`. -/
lemma monomialBasis_exponents {f : Poly 1} {c : ℂ} {ℓ : ℕ} (hc : c ≠ 0) (hℓ : 2 ≤ ℓ)
    (hfc : toPoly1 f = Polynomial.C c * Polynomial.X ^ ℓ) {μ : ℕ} {β : Fin μ → (Fin 1 →₀ ℕ)}
    (hβ : IsMonomialBasis f β) :
    Function.Injective (fun j => β j 0) ∧ ∀ j, β j 0 + 1 < ℓ := by
  refine ⟨fun i j hij => hβ.1.injective ?_, fun j => ?_⟩
  · simp only at hij
    rw [finsupp_fin1 (β i), finsupp_fin1 (β j), hij]
  · by_contra hlt
    push_neg at hlt
    apply hβ.1.ne_zero j
    rw [Ideal.Quotient.eq_zero_iff_mem, finsupp_fin1 (β j), ← X_pow_eq_monomial]
    have hd : pderiv 0 f = C (c * ℓ) * X 0 ^ (ℓ - 1) := by
      apply toPoly1.injective; rw [toPoly1_pderiv, hfc, Polynomial.derivative_C_mul_X_pow]; simp
    have hmem : (X 0 : Poly 1) ^ (ℓ - 1) ∈ jacobianIdeal f := by
      have h1 : pderiv 0 f ∈ jacobianIdeal f := Ideal.subset_span ⟨0, rfl⟩
      have hcl : (c * ℓ : ℂ) ≠ 0 := mul_ne_zero hc (by exact_mod_cast (by omega : ℓ ≠ 0))
      have := Ideal.mul_mem_left _ (C (c * ℓ)⁻¹) h1
      rwa [hd, ← mul_assoc, ← map_mul, inv_mul_cancel₀ hcl, map_one, one_mul] at this
    rw [show β j 0 = (β j 0 - (ℓ - 1)) + (ℓ - 1) by omega, pow_add]
    exact Ideal.mul_mem_left _ _ hmem

section PolyCalc

open Polynomial

lemma coeff_C_mul_X_pow_add_sum {μ : ℕ} {c : ℂ} {ℓ : ℕ} {k : Fin μ → ℕ}
    (hk : Function.Injective k) (hkℓ : ∀ j, k j + 1 < ℓ) (s : Fin μ → ℂ) (n : ℕ) :
    (Polynomial.C c * Polynomial.X ^ ℓ + ∑ j, Polynomial.C (s j) * Polynomial.X ^ k j).coeff n =
      if n = ℓ then c else if h : ∃ j, k j = n then s h.choose else 0 := by
  classical
  simp only [Polynomial.coeff_add, coeff_C_mul_X_pow, finset_sum_coeff]
  split_ifs with h1 h2
  · subst h1
    rw [Finset.sum_eq_zero]; · simp
    intro j _; have := hkℓ j; rw [if_neg (by omega)]
  · have hc := h2.choose_spec
    rw [Finset.sum_eq_single h2.choose]
    · simp [hc]
    · intro b _ hb; rw [if_neg]; intro h; apply hb; apply hk; rw [← h, hc]
    · simp
  · push_neg at h2
    rw [Finset.sum_eq_zero]; · simp
    intro j _; rw [if_neg (fun h => h2 j h.symm)]

/-- For `P=cX^ℓ+∑ s_j X^{k_j}`, with distinct `k_j<ℓ-1`, a root of multiplicity `ℓ-1` of `P'` with value zero for `P` forces every `s_j=0`. -/
lemma coeff_eq_zero_of_rootMultiplicity {μ : ℕ} {c : ℂ} {ℓ : ℕ} (hc : c ≠ 0) (hℓ : 2 ≤ ℓ)
    {k : Fin μ → ℕ} (hk : Function.Injective k) (hkℓ : ∀ j, k j + 1 < ℓ) (s : Fin μ → ℂ) (a : ℂ)
    (hroot : Polynomial.rootMultiplicity a (Polynomial.derivative
      (Polynomial.C c * Polynomial.X ^ ℓ + ∑ j, Polynomial.C (s j) * Polynomial.X ^ k j)) = ℓ - 1)
    (hval : (Polynomial.C c * Polynomial.X ^ ℓ +
      ∑ j, Polynomial.C (s j) * Polynomial.X ^ k j).eval a = 0) :
    ∀ j, s j = 0 := by
  classical
  set P := Polynomial.C c * Polynomial.X ^ ℓ + ∑ j, Polynomial.C (s j) * Polynomial.X ^ k j
    with hP
  have hcoeff := coeff_C_mul_X_pow_add_sum hk hkℓ s (c := c)
  have hPk : ∀ j, P.coeff (k j) = s j := by
    intro j
    rw [hcoeff, if_neg (by have := hkℓ j; omega)]
    have h : ∃ i, k i = k j := ⟨j, rfl⟩
    rw [dif_pos h]; congr 1; exact hk h.choose_spec
  have hPℓ1 : P.coeff (ℓ - 1) = 0 := by
    rw [hcoeff, if_neg (by omega), dif_neg]
    rintro ⟨j, hj⟩; have := hkℓ j; omega
  set D := derivative P with hD
  have hDdeg : D.natDegree ≤ ℓ - 1 := by
    rw [natDegree_le_iff_coeff_eq_zero]
    intro n hn
    have hn' : ℓ - 1 < n := by exact_mod_cast hn
    rw [hD, coeff_derivative, hcoeff, if_neg (by omega), dif_neg]; · simp
    rintro ⟨j, hj⟩; have := hkℓ j; omega
  have hDℓ : D.coeff (ℓ - 1) = c * ℓ := by
    rw [hD, coeff_derivative, hcoeff, if_pos (by omega)]
    congr 1; rw [show ℓ = (ℓ - 1) + 1 by omega]; push_cast; simp
  have hD0 : D ≠ 0 := by
    intro h; rw [h] at hDℓ; simp at hDℓ
    rcases hDℓ with h | h
    · exact hc h
    · omega
  have hDnat : D.natDegree = ℓ - 1 :=
    le_antisymm hDdeg (le_natDegree_of_ne_zero (by rw [hDℓ]; simp [hc]; omega))
  have hdvd : (Polynomial.X - Polynomial.C a) ^ (ℓ - 1) ∣ D := hroot ▸ pow_rootMultiplicity_dvd D a
  have hmon : ((Polynomial.X - Polynomial.C a) ^ (ℓ - 1)).Monic := (monic_X_sub_C a).pow _
  have hDeq : D = Polynomial.C D.leadingCoeff * (Polynomial.X - Polynomial.C a) ^ (ℓ - 1) :=
    eq_leadingCoeff_mul_of_monic_of_dvd_of_natDegree_le hmon hdvd
      (by rw [natDegree_pow, natDegree_X_sub_C]; omega)
  have hlc : D.leadingCoeff ≠ 0 := leadingCoeff_ne_zero.mpr hD0
  have ha : a = 0 := by
    have h1 : D.nextCoeff = 0 := by
      rw [nextCoeff_of_natDegree_pos (by omega), hDnat, hD, coeff_derivative,
        show ℓ - 1 - 1 + 1 = ℓ - 1 by omega, hPℓ1, zero_mul]
    rw [hDeq, nextCoeff_C_mul, (monic_X_sub_C a).nextCoeff_pow, nextCoeff_X_sub_C] at h1
    simp only [nsmul_eq_mul, mul_neg, neg_eq_zero, mul_eq_zero] at h1
    rcases h1 with h | h | h
    · exact absurd h hlc
    · exfalso; have : ((ℓ - 1 : ℕ) : ℂ) ≠ 0 := by exact_mod_cast (by omega : ℓ - 1 ≠ 0)
      exact this h
    · exact h
  subst ha
  intro j
  by_cases hk0 : k j = 0
  · rw [← hPk j, hk0, coeff_zero_eq_eval_zero]; exact hval
  · have h1 : D.coeff (k j - 1) = s j * k j := by
      rw [hD, coeff_derivative, show k j - 1 + 1 = k j by omega, hPk j]
      congr 1; rw [show k j = (k j - 1) + 1 by omega]; push_cast; simp
    have h2 : D.coeff (k j - 1) = 0 := by
      rw [hDeq]; simp only [map_zero, sub_zero, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
      rw [if_neg (by have := hkℓ j; omega), mul_zero]
    rw [h2] at h1
    have : (k j : ℂ) ≠ 0 := by exact_mod_cast hk0
    exact (mul_eq_zero.mp h1.symm).resolve_right this

end PolyCalc

/-! ## The one-variable stratum theorem -/

/-- The stratum inclusion in one variable, proved directly; every basis monomial has degree less than `d`, so every parameter vanishes. -/
theorem varchenkoTheoremFor_one_variable : VarchenkoTheoremFor 1 := by
  intro w d f hw hf hcrit h0 μ β hβ
  obtain ⟨c, ℓ, hc, hℓ, -, hfc⟩ := eq_C_mul_X_pow_of_isolated hw hf hcrit h0
  obtain ⟨hinj, hlt⟩ := monomialBasis_exponents hc hℓ hfc hβ
  refine ⟨1, one_pos, fun s p _ _ _ hval hmil j _ => ?_⟩
  set k : Fin μ → ℕ := fun j => β j 0
  set P := Polynomial.C c * Polynomial.X ^ ℓ + ∑ j, Polynomial.C (s j) * Polynomial.X ^ k j
  have hcl : (c * ℓ : ℂ) ≠ 0 := mul_ne_zero hc (by exact_mod_cast (by omega : ℓ ≠ 0))
  have hMP : toPoly1 (miniversalPoly f β s) = P := by
    simp only [miniversalPoly, map_add, map_sum, hfc, P]
    congr 1; refine Finset.sum_congr rfl fun j _ => ?_
    rw [finsupp_fin1 (β j), ← C_mul_X_pow_eq_monomial]; simp [k]
  have hcoeff := coeff_C_mul_X_pow_add_sum hinj hlt s (c := c)
  have hdP : Polynomial.derivative P ≠ 0 := by
    intro h
    have := congrArg (fun Q => Polynomial.coeff Q (ℓ - 1)) h
    simp only [Polynomial.coeff_derivative, Polynomial.coeff_zero] at this
    rw [show ℓ - 1 + 1 = ℓ by omega, hcoeff, if_pos rfl] at this
    rcases mul_eq_zero.mp this with h1 | h1
    · exact hc h1
    · have : ((ℓ - 1 : ℕ) : ℂ) + 1 = ((ℓ - 1 + 1 : ℕ) : ℂ) := by push_cast; ring
      rw [this] at h1; exact_mod_cast (by omega : ℓ - 1 + 1 ≠ 0) (by exact_mod_cast h1)
  have hpMP : pderiv 0 (miniversalPoly f β s) ≠ 0 := by
    intro h; apply hdP; rw [← hMP, ← toPoly1_pderiv, h, map_zero]
  have hpf : pderiv 0 f ≠ 0 := by
    intro h
    have := congrArg toPoly1 h
    rw [toPoly1_pderiv, hfc, Polynomial.derivative_C_mul_X_pow, map_zero] at this
    simp at this
    rcases this with h1 | h1
    · exact hc h1
    · omega
  have hL : localMilnorNumber (miniversalDeformation f β s) p =
      Polynomial.rootMultiplicity (p 0) (Polynomial.derivative P) := by
    rw [show miniversalDeformation f β s = fun x => eval x (miniversalPoly f β s) from rfl,
      localMilnorNumber_eval_one hpMP, hMP]
  have hR : localMilnorNumber (fun x => eval x f) 0 = ℓ - 1 := by
    rw [localMilnorNumber_eval_one hpf, hfc, Polynomial.derivative_C_mul_X_pow]
    have h := Polynomial.rootMultiplicity_mul (p := Polynomial.C (c * ℓ))
      (q := Polynomial.X ^ (ℓ - 1)) (x := (0 : ℂ))
      (mul_ne_zero (by rw [Ne, Polynomial.C_eq_zero]; exact hcl) (pow_ne_zero _ Polynomial.X_ne_zero))
    simp only [Pi.zero_apply]
    rw [h, Polynomial.rootMultiplicity_C, zero_add]
    simpa using Polynomial.rootMultiplicity_X_sub_C_pow (0 : ℂ) (ℓ - 1)
  have hv : P.eval (p 0) = 0 := by
    rw [← hMP, ← eval_eq_toPoly1_eval]; exact hval
  exact coeff_eq_zero_of_rootMultiplicity hc hℓ hinj hlt s (p 0) (hL ▸ hR ▸ hmil) hv j

/-- The full neighborhood description of the one-variable zero-critical-value `μ`-constant stratum: it is the zero parameter alone. -/
theorem varchenko_stratum_eq_one_variable {w : Fin 1 → ℕ} {d : ℕ} {f : Poly 1} (hw : ∀ i, 0 < w i)
    (hf : f.IsWeightedHomogeneous w d) (hcrit : HasIsolatedCriticalPoint f) (h0 : eval 0 f = 0)
    {μ : ℕ} {β : Fin μ → (Fin 1 →₀ ℕ)} (hβ : IsMonomialBasis f β) :
    ∃ ε > 0, ∀ s : Fin μ → ℂ, ‖s‖ < ε →
      ((∃ p : Fin 1 → ℂ, ‖p‖ < ε ∧
          IsIsolatedCriticalPointAt (miniversalDeformation f β s) p ∧
          miniversalDeformation f β s p = 0 ∧
          localMilnorNumber (miniversalDeformation f β s) p =
            localMilnorNumber (fun x => eval x f) 0) ↔
        ∀ j, Finsupp.weight w (β j) < d → s j = 0) := by
  obtain ⟨ε, hε, H⟩ := varchenkoTheoremFor_one_variable w d f hw hf hcrit h0 μ β hβ
  obtain ⟨c, ℓ, hc, hℓ, hℓd, hfc⟩ := eq_C_mul_X_pow_of_isolated hw hf hcrit h0
  obtain ⟨-, hlt⟩ := monomialBasis_exponents hc hℓ hfc hβ
  have hwt : ∀ j, Finsupp.weight w (β j) < d := by
    intro j
    rw [Finsupp.weight_apply, Finsupp.sum_fintype _ _ (by simp)]
    simp only [Fin.sum_univ_one, smul_eq_mul, ← hℓd]
    exact Nat.mul_lt_mul_of_pos_right (by have := hlt j; omega) (hw 0)
  refine ⟨ε, hε, fun s hs => ⟨fun ⟨p, hp, h1, h2, h3⟩ => H s p hs hp h1 h2 h3, fun hs0 => ?_⟩⟩
  have hs0' : s = 0 := funext fun j => hs0 j (hwt j)
  subst hs0'
  have hF : miniversalDeformation f β 0 = fun x => eval x f := by
    funext x; simp [miniversalDeformation, miniversalPoly]
  refine ⟨0, by simpa using hε, ?_, ?_, ?_⟩
  · rw [hF]; exact isIsolatedCriticalPointAt_of_hasIsolatedCriticalPoint hcrit
  · rw [hF]; exact h0
  · rw [hF]

/-- The zero-variable case: the deformation is the constant parameter. -/
theorem varchenkoTheoremFor_zero_variables : VarchenkoTheoremFor 0 := by
  intro w d f hw hf hcrit h0 μ β hβ
  refine ⟨1, one_pos, fun s p _ _ _ hval _ j _ => ?_⟩
  have hsub : Subsingleton (Fin μ) := ⟨fun i k => hβ.1.injective (by
    simp only [Subsingleton.elim (β i) (β k)])⟩
  have hp : p = 0 := Subsingleton.elim _ _
  subst hp
  have : miniversalDeformation f β s 0 = s j := by
    simp only [miniversalDeformation, miniversalPoly, map_add, h0, zero_add, map_sum]
    rw [Fintype.sum_subsingleton _ j]
    rw [Subsingleton.elim (β j) 0, ← C_apply]; simp
  rw [← this, hval]

/-- Using the zero- and one-variable cases, the stratum hypothesis is equivalent to its restriction to `n≥2`. -/
theorem varchenkoTheorem_iff_two_le :
    VarchenkoTheorem ↔ ∀ n, 2 ≤ n → VarchenkoTheoremFor n := by
  refine ⟨fun h n _ => h n, fun h n => ?_⟩
  rcases n with _ | _ | n
  · exact varchenkoTheoremFor_zero_variables
  · exact varchenkoTheoremFor_one_variable
  · exact h _ (by omega)

end Yau
