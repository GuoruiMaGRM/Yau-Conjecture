import RequestProject.Yau.Analytic.Expansion
import RequestProject.Yau.Appendix.AnalyticMilnor
import RequestProject.Yau.Basic.PolyCalculus

/-!
# Local Milnor numbers and analytic coordinate changes

`taylorAt h p` represents the germ of `h` at `p` in `ℂ{x}`. Addition and multiplication
are respected, and the sum function gives an inverse for analytic germs.
`localJacobianIdeal g p` is generated by the Taylor series of the partial derivatives.
`localMilnorNumber g p` is the dimension of the corresponding quotient.
An analytic coordinate change with invertible differential preserves this number;
at the origin, polynomial functions recover `milnorNumber`.
-/

open MvPolynomial Filter Topology

noncomputable section

namespace Yau

variable {n : ℕ}

/-! ## Taylor series at a point -/

/-- The Taylor series of `h` at `p`, as an element of `ℂ{x}`. -/
def taylorAt (h : (Fin n → ℂ) → ℂ) (p : Fin n → ℂ) : ConvSeries n :=
  taylorConv0 (fun y => h (p + y))

lemma analyticAt_shift {h : (Fin n → ℂ) → ℂ} {p : Fin n → ℂ} (H : AnalyticAt ℂ h p) :
    AnalyticAt ℂ (fun y => h (p + y)) 0 := by
  have : AnalyticAt ℂ (fun y : Fin n → ℂ => p + y) 0 := analyticAt_const.add analyticAt_id
  exact AnalyticAt.comp_of_eq (g := h) (f := fun y => p + y) H this (by simp)

lemma tendsto_shift (p : Fin n → ℂ) : Tendsto (fun y : Fin n → ℂ => p + y) (𝓝 0) (𝓝 p) := by
  have := ((continuous_const.add continuous_id : Continuous fun y : Fin n → ℂ => p + y).tendsto 0)
  simpa using this

lemma taylorAt_congr {h h' : (Fin n → ℂ) → ℂ} {p : Fin n → ℂ} (hh : h =ᶠ[𝓝 p] h') :
    taylorAt h p = taylorAt h' p :=
  Subtype.ext (taylorSeries0_congr (hh.comp_tendsto (tendsto_shift p)))

lemma taylorAt_add {h₁ h₂ : (Fin n → ℂ) → ℂ} {p : Fin n → ℂ} (H₁ : AnalyticAt ℂ h₁ p)
    (H₂ : AnalyticAt ℂ h₂ p) : taylorAt (fun x => h₁ x + h₂ x) p = taylorAt h₁ p + taylorAt h₂ p :=
  Subtype.ext (taylorSeries0_add (analyticAt_shift H₁) (analyticAt_shift H₂))

lemma taylorAt_mul {h₁ h₂ : (Fin n → ℂ) → ℂ} {p : Fin n → ℂ} (H₁ : AnalyticAt ℂ h₁ p)
    (H₂ : AnalyticAt ℂ h₂ p) : taylorAt (fun x => h₁ x * h₂ x) p = taylorAt h₁ p * taylorAt h₂ p :=
  Subtype.ext (taylorSeries0_mul (analyticAt_shift H₁) (analyticAt_shift H₂))

lemma taylorAt_eval_zero (Q : Poly n) : taylorAt (fun x => eval x Q) 0 = polyToConv Q :=
  Subtype.ext (by simpa [taylorAt] using taylorSeries0_eval Q)

lemma taylorAt_const (c : ℂ) (p : Fin n → ℂ) :
    taylorAt (fun _ => c) p = algebraMap ℂ (ConvSeries n) c := by
  have := taylorAt_eval_zero (n := n) (C c)
  simp only [eval_C] at this
  rw [show taylorAt (fun _ => c) p = taylorAt (fun _ => c) 0 from rfl, this]
  simp [polyToConv]

lemma taylorAt_smul {h : (Fin n → ℂ) → ℂ} {p : Fin n → ℂ} (H : AnalyticAt ℂ h p) (c : ℂ) :
    taylorAt (fun x => c * h x) p = c • taylorAt h p := by
  rw [taylorAt_mul analyticAt_const H, taylorAt_const, Algebra.smul_def]

lemma taylorAt_sum {ι : Type*} (s : Finset ι) {h : ι → (Fin n → ℂ) → ℂ} {p : Fin n → ℂ}
    (H : ∀ i ∈ s, AnalyticAt ℂ (h i) p) :
    taylorAt (fun x => ∑ i ∈ s, h i x) p = ∑ i ∈ s, taylorAt (h i) p := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using taylorAt_const (n := n) 0 p
  | insert a s ha ih =>
    simp only [Finset.sum_insert ha]
    rw [taylorAt_add (H a (Finset.mem_insert_self a s))
      (Finset.analyticAt_fun_sum _ fun i hi => H i (Finset.mem_insert_of_mem hi)),
      ih fun i hi => H i (Finset.mem_insert_of_mem hi)]

/-- Analytic functions with the same Taylor series agree near `p`. -/
theorem eventuallyEq_of_taylorAt_eq {h h' : (Fin n → ℂ) → ℂ} {p : Fin n → ℂ}
    (H : AnalyticAt ℂ h p) (H' : AnalyticAt ℂ h' p) (he : taylorAt h p = taylorAt h' p) :
    h =ᶠ[𝓝 p] h' := by
  have hA : AnalyticAt ℂ (fun x => (-1 : ℂ) * h' x) p := analyticAt_const.mul H'
  have hS : AnalyticAt ℂ (fun x => h x + (-1 : ℂ) * h' x) p := H.add hA
  have hsub : taylorSeries0 (fun y => h (p + y) + (-1 : ℂ) * h' (p + y)) = 0 := by
    have h1 := taylorAt_add H hA
    have h2 := taylorAt_mul (analyticAt_const (v := (-1 : ℂ)) (x := p)) H'
    have : taylorAt (fun x => h x + (-1) * h' x) p = 0 := by
      rw [h1, h2, taylorAt_const, he]; simp; ring
    exact congrArg Subtype.val this
  have hz := eventuallyEq_zero_of_taylor0_eq_zero (analyticAt_shift hS) hsub
  have hz' : ∀ᶠ y in 𝓝 (0 : Fin n → ℂ), h (p + y) = h' (p + y) := by
    filter_upwards [hz] with y hy
    have hy' : h (p + y) + (-1 : ℂ) * h' (p + y) = 0 := hy
    linear_combination hy'
  have ht : Tendsto (fun x : Fin n → ℂ => x - p) (𝓝 p) (𝓝 0) := by
    simpa using ((continuous_id.sub continuous_const : Continuous fun x : Fin n → ℂ => x - p).tendsto p)
  filter_upwards [ht.eventually hz'] with x hx
  simpa using hx

/-! ## Sum functions: the inverse construction -/

/-- The sum function of `F` centered at `p`, namely `x ↦ F(x - p)`. -/
def sumAt (F : ConvSeries n) (p : Fin n → ℂ) : (Fin n → ℂ) → ℂ := fun x => sumFun F (x - p)

lemma analyticAt_sumAt (F : ConvSeries n) (p : Fin n → ℂ) : AnalyticAt ℂ (sumAt F p) p := by
  have : AnalyticAt ℂ (fun x : Fin n → ℂ => x - p) p := analyticAt_id.sub analyticAt_const
  exact AnalyticAt.comp_of_eq (g := sumFun F) (f := fun x => x - p) (analyticAt_sumFun F) this
    (by simp)

lemma taylorAt_sumAt (F : ConvSeries n) (p : Fin n → ℂ) : taylorAt (sumAt F p) p = F :=
  Subtype.ext (by simpa [taylorAt, sumAt] using taylorSeries0_sumFun F)

lemma sumAt_taylorAt {h : (Fin n → ℂ) → ℂ} {p : Fin n → ℂ} (H : AnalyticAt ℂ h p) :
    sumAt (taylorAt h p) p =ᶠ[𝓝 p] h :=
  eventuallyEq_of_taylorAt_eq (analyticAt_sumAt _ p) H (taylorAt_sumAt _ p)

/-! ## Pullback by an analytic map -/

section Pullback

variable {Φ : (Fin n → ℂ) → (Fin n → ℂ)} {p : Fin n → ℂ}

/-- The Taylor series at `p` of the pullback `F ∘ Φ`, with `F` regarded as a germ at `Φ p`. -/
def pullFun (Φ : (Fin n → ℂ) → (Fin n → ℂ)) (p : Fin n → ℂ) (F : ConvSeries n) : ConvSeries n :=
  taylorAt (fun x => sumAt F (Φ p) (Φ x)) p

lemma analyticAt_sumAt_comp (hΦ : AnalyticAt ℂ Φ p) (F : ConvSeries n) :
    AnalyticAt ℂ (fun x => sumAt F (Φ p) (Φ x)) p :=
  (analyticAt_sumAt F (Φ p)).comp hΦ

lemma pullFun_taylorAt (hΦ : AnalyticAt ℂ Φ p) {k : (Fin n → ℂ) → ℂ} (hk : AnalyticAt ℂ k (Φ p)) :
    pullFun Φ p (taylorAt k (Φ p)) = taylorAt (fun x => k (Φ x)) p :=
  taylorAt_congr ((sumAt_taylorAt hk).comp_tendsto hΦ.continuousAt)

/-- The `ℂ`-algebra homomorphism `ℂ{x} → ℂ{x}` induced by pullback along `Φ`. -/
def pullback (hΦ : AnalyticAt ℂ Φ p) : ConvSeries n →ₐ[ℂ] ConvSeries n where
  toFun := pullFun Φ p
  map_one' := by
    have h1 : (1 : ConvSeries n) = taylorAt (fun _ => (1 : ℂ)) (Φ p) := by
      rw [taylorAt_const, map_one]
    conv_lhs => rw [h1]
    rw [pullFun_taylorAt hΦ analyticAt_const, taylorAt_const, map_one]
  map_mul' F G := by
    have hFG : AnalyticAt ℂ (fun x => sumAt F (Φ p) x * sumAt G (Φ p) x) (Φ p) :=
      (analyticAt_sumAt F (Φ p)).mul (analyticAt_sumAt G (Φ p))
    have h := pullFun_taylorAt hΦ hFG
    rw [taylorAt_mul (analyticAt_sumAt F (Φ p)) (analyticAt_sumAt G (Φ p)), taylorAt_sumAt,
      taylorAt_sumAt] at h
    rw [h, taylorAt_mul (analyticAt_sumAt_comp hΦ F) (analyticAt_sumAt_comp hΦ G)]
    rfl
  map_zero' := by
    have h0 : (0 : ConvSeries n) = taylorAt (fun _ => (0 : ℂ)) (Φ p) := by
      rw [taylorAt_const, map_zero]
    conv_lhs => rw [h0]
    rw [pullFun_taylorAt hΦ analyticAt_const, taylorAt_const, map_zero]
  map_add' F G := by
    have hFG : AnalyticAt ℂ (fun x => sumAt F (Φ p) x + sumAt G (Φ p) x) (Φ p) :=
      (analyticAt_sumAt F (Φ p)).add (analyticAt_sumAt G (Φ p))
    have h := pullFun_taylorAt hΦ hFG
    rw [taylorAt_add (analyticAt_sumAt F (Φ p)) (analyticAt_sumAt G (Φ p)), taylorAt_sumAt,
      taylorAt_sumAt] at h
    rw [h, taylorAt_add (analyticAt_sumAt_comp hΦ F) (analyticAt_sumAt_comp hΦ G)]
    rfl
  commutes' c := by
    have hc : algebraMap ℂ (ConvSeries n) c = taylorAt (fun _ => c) (Φ p) := (taylorAt_const c _).symm
    show pullFun Φ p (algebraMap ℂ (ConvSeries n) c) = _
    conv_lhs => rw [hc]
    rw [pullFun_taylorAt hΦ analyticAt_const, taylorAt_const]

lemma pullback_apply (hΦ : AnalyticAt ℂ Φ p) (F : ConvSeries n) :
    pullback hΦ F = pullFun Φ p F := rfl

lemma pullback_taylorAt (hΦ : AnalyticAt ℂ Φ p) {k : (Fin n → ℂ) → ℂ} (hk : AnalyticAt ℂ k (Φ p)) :
    pullback hΦ (taylorAt k (Φ p)) = taylorAt (fun x => k (Φ x)) p :=
  pullFun_taylorAt hΦ hk

/-- Local inverse maps induce inverse pullbacks. -/
lemma pullFun_pullFun {Ψ : (Fin n → ℂ) → (Fin n → ℂ)} {q : Fin n → ℂ} (hΦ : AnalyticAt ℂ Φ p)
    (hΨ : AnalyticAt ℂ Ψ q) (hq : Φ p = q) (hΨp : Ψ q = p) (hleft : ∀ᶠ x in 𝓝 p, Ψ (Φ x) = x)
    (F : ConvSeries n) : pullFun Φ p (pullFun Ψ q F) = F := by
  subst hq
  rw [show pullFun Ψ (Φ p) F = taylorAt (fun y => sumAt F (Ψ (Φ p)) (Ψ y)) (Φ p) from rfl,
    pullFun_taylorAt hΦ (analyticAt_sumAt_comp hΨ F)]
  conv_rhs => rw [← taylorAt_sumAt F p]
  apply taylorAt_congr
  filter_upwards [hleft] with x hx
  simp only [hx, hΨp]

end Pullback

/-! ## Local Jacobian ideals and local Milnor numbers -/

/-- The `i`th partial derivative of `g : ℂⁿ → ℂ`. -/
def partialFun (i : Fin n) (g : (Fin n → ℂ) → ℂ) : (Fin n → ℂ) → ℂ :=
  fun x => fderiv ℂ g x (Pi.single i 1)

/-- An isolated critical point: the differential vanishes at `p` and is nonzero in a punctured neighborhood of `p`. -/
def IsIsolatedCriticalPointAt (g : (Fin n → ℂ) → ℂ) (p : Fin n → ℂ) : Prop :=
  fderiv ℂ g p = 0 ∧ ∀ᶠ x in 𝓝[≠] p, fderiv ℂ g x ≠ 0

/-- The ideal in `ℂ{x}` generated by the Taylor series at `p` of the partial derivatives of `g`. -/
def localJacobianIdeal (g : (Fin n → ℂ) → ℂ) (p : Fin n → ℂ) : Ideal (ConvSeries n) :=
  Ideal.span (Set.range fun i => taylorAt (partialFun i g) p)

/-- The local Milnor number `μ(g,p) = dim_ℂ ℂ{x}/(∂₁g,…,∂ₙg)`. -/
def localMilnorNumber (g : (Fin n → ℂ) → ℂ) (p : Fin n → ℂ) : ℕ :=
  Module.finrank ℂ (ConvSeries n ⧸ localJacobianIdeal g p)

lemma analyticAt_clm_apply {E G H : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [NormedAddCommGroup G] [NormedSpace ℂ G] [NormedAddCommGroup H] [NormedSpace ℂ H]
    {f : E → (G →L[ℂ] H)} {x : E} (hf : AnalyticAt ℂ f x) (v : G) :
    AnalyticAt ℂ (fun y => f y v) x := by
  have := ((ContinuousLinearMap.apply ℂ H v).analyticAt (f x)).comp hf
  exact this

lemma analyticAt_partialFun {g : (Fin n → ℂ) → ℂ} {q : Fin n → ℂ} (hg : AnalyticAt ℂ g q)
    (i : Fin n) : AnalyticAt ℂ (partialFun i g) q :=
  analyticAt_clm_apply hg.fderiv _

lemma localJacobianIdeal_congr {g g' : (Fin n → ℂ) → ℂ} {p : Fin n → ℂ} (h : g =ᶠ[𝓝 p] g') :
    localJacobianIdeal g p = localJacobianIdeal g' p := by
  have : ∀ i, taylorAt (partialFun i g) p = taylorAt (partialFun i g') p := fun i =>
    taylorAt_congr (by
      filter_upwards [h.fderiv (𝕜 := ℂ)] with x hx
      simp [partialFun, hx])
  simp [localJacobianIdeal, this]

lemma localMilnorNumber_congr {g g' : (Fin n → ℂ) → ℂ} {p : Fin n → ℂ} (h : g =ᶠ[𝓝 p] g') :
    localMilnorNumber g p = localMilnorNumber g' p := by
  rw [localMilnorNumber, localMilnorNumber, localJacobianIdeal_congr h]

/-- The chain rule for partial derivatives, valid near `p`. -/
lemma partialFun_comp_eventually {g : (Fin n → ℂ) → ℂ} {Φ : (Fin n → ℂ) → (Fin n → ℂ)}
    {p : Fin n → ℂ} (hg : AnalyticAt ℂ g (Φ p)) (hΦ : AnalyticAt ℂ Φ p) (i : Fin n) :
    ∀ᶠ x in 𝓝 p, partialFun i (fun y => g (Φ y)) x =
      ∑ j, partialFun j g (Φ x) * fderiv ℂ Φ x (Pi.single i 1) j := by
  have hg' : ∀ᶠ x in 𝓝 p, AnalyticAt ℂ g (Φ x) :=
    hΦ.continuousAt.eventually hg.eventually_analyticAt
  filter_upwards [hg', hΦ.eventually_analyticAt] with x hgx hΦx
  have hcomp : fderiv ℂ (fun y => g (Φ y)) x = (fderiv ℂ g (Φ x)).comp (fderiv ℂ Φ x) :=
    fderiv_comp x hgx.differentiableAt hΦx.differentiableAt
  simp only [partialFun, hcomp, ContinuousLinearMap.comp_apply]
  set v := fderiv ℂ Φ x (Pi.single i 1)
  conv_lhs => rw [show v = ∑ j, v j • (Pi.single j (1 : ℂ) : Fin n → ℂ) by
    ext k; simp [Pi.single_apply]]
  rw [map_sum]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [map_smul, smul_eq_mul, mul_comm]

/-- The chain rule gives the corresponding inclusion between the pulled-back Jacobian ideals. -/
lemma localJacobianIdeal_comp_le {g : (Fin n → ℂ) → ℂ} {Φ : (Fin n → ℂ) → (Fin n → ℂ)}
    {p : Fin n → ℂ} (hg : AnalyticAt ℂ g (Φ p)) (hΦ : AnalyticAt ℂ Φ p) :
    localJacobianIdeal (fun y => g (Φ y)) p ≤
      (localJacobianIdeal g (Φ p)).map (pullback hΦ) := by
  rw [localJacobianIdeal, Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  show taylorAt (partialFun i fun y => g (Φ y)) p ∈ _
  have hA : ∀ j, AnalyticAt ℂ (fun x => fderiv ℂ Φ x (Pi.single i 1) j) p := fun j => by
    have := ((ContinuousLinearMap.proj (R := ℂ) (φ := fun _ : Fin n => ℂ) j).analyticAt _).comp
      (analyticAt_clm_apply hΦ.fderiv (Pi.single i (1 : ℂ)))
    exact this
  have hB : ∀ j, AnalyticAt ℂ (fun x => partialFun j g (Φ x)) p := fun j =>
    (analyticAt_partialFun hg j).comp hΦ
  rw [taylorAt_congr (partialFun_comp_eventually hg hΦ i),
    taylorAt_sum (h := fun j x => partialFun j g (Φ x) * fderiv ℂ Φ x (Pi.single i 1) j) _
      (fun j _ => (hB j).mul (hA j))]
  refine Ideal.sum_mem _ fun j _ => ?_
  rw [taylorAt_mul (hB j) (hA j)]
  refine Ideal.mul_mem_right _ _ ?_
  rw [← pullback_taylorAt hΦ (analyticAt_partialFun hg j)]
  exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨j, rfl⟩)

/-! ## Invariance under coordinate changes -/

/-- An analytic map with invertible differential has an analytic local inverse. -/
lemma exists_analytic_localInverse {Φ : (Fin n → ℂ) → (Fin n → ℂ)} {p : Fin n → ℂ}
    (hΦ : AnalyticAt ℂ Φ p) {e : (Fin n → ℂ) ≃L[ℂ] (Fin n → ℂ)} (he : fderiv ℂ Φ p = e) :
    ∃ Ψ : (Fin n → ℂ) → (Fin n → ℂ), AnalyticAt ℂ Ψ (Φ p) ∧ Ψ (Φ p) = p ∧
      (∀ᶠ x in 𝓝 p, Ψ (Φ x) = x) ∧ (∀ᶠ y in 𝓝 (Φ p), Φ (Ψ y) = y) := by
  have hstrict : HasStrictFDerivAt Φ (e : (Fin n → ℂ) →L[ℂ] (Fin n → ℂ)) p := by
    have := hΦ.hasStrictFDerivAt; rwa [he] at this
  refine ⟨hstrict.localInverse Φ e p, ?_, hstrict.localInverse_apply_image,
    hstrict.eventually_left_inverse, hstrict.eventually_right_inverse⟩
  have hmem : Φ p ∈ (hstrict.toOpenPartialHomeomorph Φ).target :=
    hstrict.image_mem_toOpenPartialHomeomorph_target
  have hsymm : (hstrict.toOpenPartialHomeomorph Φ).symm (Φ p) = p :=
    hstrict.localInverse_apply_image
  refine (hstrict.toOpenPartialHomeomorph Φ).analyticAt_symm (i := e) hmem ?_ ?_
  · rw [hsymm]; exact hΦ
  · rw [hsymm]; exact he

/-- Analytic coordinate changes with invertible differential preserve isolated critical points. -/
theorem isIsolatedCriticalPointAt_of_comp {g : (Fin n → ℂ) → ℂ} {Φ : (Fin n → ℂ) → (Fin n → ℂ)}
    {p : Fin n → ℂ} (hg : AnalyticAt ℂ g (Φ p)) (hΦ : AnalyticAt ℂ Φ p)
    {e : (Fin n → ℂ) ≃L[ℂ] (Fin n → ℂ)} (he : fderiv ℂ Φ p = e)
    (hcrit : IsIsolatedCriticalPointAt (fun y => g (Φ y)) p) :
    IsIsolatedCriticalPointAt g (Φ p) := by
  obtain ⟨Ψ, hΨ, hΨp, hleft, hright⟩ := exists_analytic_localInverse hΦ he
  have hcomp : ∀ᶠ x in 𝓝 p, fderiv ℂ (fun y => g (Φ y)) x = (fderiv ℂ g (Φ x)).comp (fderiv ℂ Φ x) := by
    have hg' : ∀ᶠ x in 𝓝 p, AnalyticAt ℂ g (Φ x) :=
      hΦ.continuousAt.eventually hg.eventually_analyticAt
    filter_upwards [hg', hΦ.eventually_analyticAt] with x hgx hΦx
    exact fderiv_comp x hgx.differentiableAt hΦx.differentiableAt
  refine ⟨?_, ?_⟩
  · have h0 := hcrit.1
    rw [hcomp.self_of_nhds, he] at h0
    ext v
    have := congrArg (fun L : (Fin n → ℂ) →L[ℂ] ℂ => L (e.symm v)) h0
    simpa using this
  · have hΨt : Tendsto Ψ (𝓝[≠] (Φ p)) (𝓝[≠] p) := by
      rw [tendsto_nhdsWithin_iff]
      refine ⟨?_, ?_⟩
      · have := hΨ.continuousAt.tendsto
        rw [hΨp] at this
        exact this.mono_left nhdsWithin_le_nhds
      · filter_upwards [nhdsWithin_le_nhds hright, self_mem_nhdsWithin] with y hy hyq
        intro hp
        apply hyq
        rw [← hy, Set.mem_singleton_iff.mp hp]; rfl
    have hΨn : Tendsto Ψ (𝓝 (Φ p)) (𝓝 p) := by
      have := hΨ.continuousAt.tendsto; rwa [hΨp] at this
    filter_upwards [hΨt.eventually hcrit.2, nhdsWithin_le_nhds hright,
      nhdsWithin_le_nhds (hΨn.eventually hcomp)] with y hy hyr hyc
    intro h0
    apply hy
    rw [hyc, hyr, h0, ContinuousLinearMap.zero_comp]

set_option synthInstance.maxHeartbeats 200000 in
/-- Local Milnor numbers are invariant under analytic coordinate changes: `μ(g ∘ Φ,p) = μ(g,Φ p)`. -/
theorem localMilnorNumber_comp {g : (Fin n → ℂ) → ℂ} {Φ : (Fin n → ℂ) → (Fin n → ℂ)}
    {p : Fin n → ℂ} (hg : AnalyticAt ℂ g (Φ p)) (hΦ : AnalyticAt ℂ Φ p)
    {e : (Fin n → ℂ) ≃L[ℂ] (Fin n → ℂ)} (he : fderiv ℂ Φ p = e) :
    localMilnorNumber (fun y => g (Φ y)) p = localMilnorNumber g (Φ p) := by
  set q := Φ p with hq
  obtain ⟨Ψ, hΨ, hΨp, hleft, hright⟩ := exists_analytic_localInverse hΦ he
  -- The inverse pullbacks give an automorphism of `ℂ{x}`.
  let E : ConvSeries n ≃ₐ[ℂ] ConvSeries n :=
    AlgEquiv.ofAlgHom (pullback hΦ) (pullback hΨ)
      (AlgHom.ext fun F => pullFun_pullFun hΦ hΨ rfl hΨp hleft F)
      (AlgHom.ext fun F => pullFun_pullFun hΨ hΦ hΨp rfl hright F)
  have hEq : localJacobianIdeal (fun y => g (Φ y)) p =
      (localJacobianIdeal g q).map (E : ConvSeries n →+* ConvSeries n) := by
    apply le_antisymm
    · exact localJacobianIdeal_comp_le hg hΦ
    · have hg' : AnalyticAt ℂ (fun y => g (Φ y)) (Ψ q) := by rw [hΨp]; exact hg.comp hΦ
      have h1 := localJacobianIdeal_comp_le hg' hΨ
      rw [hΨp, localJacobianIdeal_congr (g' := g) (by
        filter_upwards [hright] with y hy
        simp [hy])] at h1
      calc (localJacobianIdeal g q).map (E : ConvSeries n →+* ConvSeries n)
          ≤ ((localJacobianIdeal (fun y => g (Φ y)) p).map (pullback hΨ)).map
              (E : ConvSeries n →+* ConvSeries n) := Ideal.map_mono h1
        _ = localJacobianIdeal (fun y => g (Φ y)) p := by
          show Ideal.map (E : ConvSeries n →+* ConvSeries n)
            (Ideal.map ((pullback hΨ : ConvSeries n →ₐ[ℂ] ConvSeries n) :
              ConvSeries n →+* ConvSeries n) _) = _
          rw [Ideal.map_map]
          convert Ideal.map_id _
          exact RingHom.ext fun F => pullFun_pullFun hΦ hΨ rfl hΨp hleft F
  rw [localMilnorNumber, localMilnorNumber]
  exact (Ideal.quotientEquivAlg (localJacobianIdeal g q) _ E hEq).toLinearEquiv.finrank_eq.symm

/-! ## Polynomial functions at the origin -/

lemma partialFun_eval (i : Fin n) (P : Poly n) :
    partialFun i (fun x => eval x P) = fun x => eval x (pderiv i P) := by
  funext x
  rw [partialFun, (hasFDerivAt_eval P x).fderiv, evalDeriv_apply]
  simp [Pi.single_apply]

lemma localJacobianIdeal_eval_zero (P : Poly n) :
    localJacobianIdeal (fun x => eval x P) 0 = convIdeal (jacobianIdeal P) := by
  rw [localJacobianIdeal, convIdeal, jacobianIdeal, Ideal.map_span, ← Set.range_comp]
  congr 2
  funext i
  simp [partialFun_eval, taylorAt_eval_zero]

end Yau
