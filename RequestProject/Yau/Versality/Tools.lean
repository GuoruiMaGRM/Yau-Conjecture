import RequestProject.Yau.Sec3_Radical.Corollary35

/-!
# Tools for the versality construction

Analytic local inverses, an algebraic Taylor formula with quadratic remainder,
powers of nilpotent elements in finite-dimensional quotients, and derivatives
of products vanishing at the base point.
-/

open MvPolynomial Filter Topology

noncomputable section

namespace Yau

/-! ## Analytic local inverses -/

/-- An analytic map with differential the identity has an analytic local inverse, whose differential is also the identity at the image point. -/
lemma exists_analytic_localInverse_id {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    [CompleteSpace E] {Φ : E → E} {p : E}
    (hΦ : AnalyticAt ℂ Φ p) (he : fderiv ℂ Φ p = ContinuousLinearMap.id ℂ E) :
    ∃ Ψ : E → E, AnalyticAt ℂ Ψ (Φ p) ∧ Ψ (Φ p) = p ∧
      (∀ᶠ x in 𝓝 p, Ψ (Φ x) = x) ∧ (∀ᶠ y in 𝓝 (Φ p), Φ (Ψ y) = y) ∧
      HasFDerivAt Ψ (ContinuousLinearMap.id ℂ E) (Φ p) := by
  set e : E ≃L[ℂ] E := ContinuousLinearEquiv.refl ℂ E
  have he' : fderiv ℂ Φ p = (e : E →L[ℂ] E) := he
  have hstrict : HasStrictFDerivAt Φ (e : E →L[ℂ] E) p := by
    have := hΦ.hasStrictFDerivAt; rwa [he'] at this
  refine ⟨hstrict.localInverse Φ e p, ?_, hstrict.localInverse_apply_image,
    hstrict.eventually_left_inverse, hstrict.eventually_right_inverse,
    hstrict.to_localInverse.hasFDerivAt⟩
  have hmem : Φ p ∈ (hstrict.toOpenPartialHomeomorph Φ).target :=
    hstrict.image_mem_toOpenPartialHomeomorph_target
  have hsymm : (hstrict.toOpenPartialHomeomorph Φ).symm (Φ p) = p :=
    hstrict.localInverse_apply_image
  refine (hstrict.toOpenPartialHomeomorph Φ).analyticAt_symm (i := e) hmem ?_ ?_
  · rw [hsymm]; exact hΦ
  · rw [hsymm]; exact he'

/-! ## The algebraic Taylor formula -/

/-- The remainder `P(x+Y)-P(x)-∑∂_iP(x)Y_i` belongs to the ideal generated by the products `Y_iY_j`. -/
theorem bind₁_X_add_sub_mem {σ R : Type*} [Fintype σ] [DecidableEq σ] [CommRing R]
    (Y : σ → MvPolynomial σ R) (P : MvPolynomial σ R) :
    bind₁ (fun i => X i + Y i) P - P - ∑ i, pderiv i P * Y i ∈
      Ideal.span (Set.range fun ij : σ × σ => Y ij.1 * Y ij.2) := by
  set I := Ideal.span (Set.range fun ij : σ × σ => Y ij.1 * Y ij.2)
  induction P using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
    have : bind₁ (fun i => X i + Y i) (p + q) - (p + q) - ∑ i, pderiv i (p + q) * Y i =
        (bind₁ (fun i => X i + Y i) p - p - ∑ i, pderiv i p * Y i) +
          (bind₁ (fun i => X i + Y i) q - q - ∑ i, pderiv i q * Y i) := by
      simp only [map_add, add_mul, Finset.sum_add_distrib]; ring
    rw [this]; exact I.add_mem hp hq
  | mul_X p j hp =>
    have hd : ∀ i, pderiv i (p * X j) * Y i =
        pderiv i p * Y i * X j + (if j = i then p * Y i else 0) := by
      intro i
      simp only [Derivation.leibniz, pderiv_X, smul_eq_mul, Pi.single_apply]
      split_ifs <;> ring
    have hsum : ∑ i, pderiv i (p * X j) * Y i =
        (∑ i, pderiv i p * Y i) * X j + p * Y j := by
      simp only [hd, Finset.sum_add_distrib, Finset.sum_mul, Finset.sum_ite_eq,
        Finset.mem_univ, if_true]
    have hYY : ∑ i, pderiv i p * (Y i * Y j) = (∑ i, pderiv i p * Y i) * Y j := by
      rw [Finset.sum_mul]; exact Finset.sum_congr rfl fun i _ => by ring
    have : bind₁ (fun i => X i + Y i) (p * X j) - p * X j - ∑ i, pderiv i (p * X j) * Y i =
        (bind₁ (fun i => X i + Y i) p - p - ∑ i, pderiv i p * Y i) * (X j + Y j) +
          ∑ i, pderiv i p * (Y i * Y j) := by
      rw [hsum, hYY, map_mul, bind₁_X_right]
      ring
    rw [this]
    exact I.add_mem (I.mul_mem_right _ hp)
      (I.sum_mem fun i _ => I.mul_mem_left _ (Ideal.subset_span ⟨(i, j), rfl⟩))

/-! ## Powers of nilpotent elements -/

/-- If `x^N∈J` and `ℂ[x]/J` is finite dimensional, then `x^{dim ℂ[x]/J}∈J`. -/
theorem pow_finrank_mem {n : ℕ} (J : Ideal (Poly n)) [Module.Finite ℂ (Poly n ⧸ J)]
    (x : Poly n) {N : ℕ} (hN : x ^ N ∈ J) : x ^ Module.finrank ℂ (Poly n ⧸ J) ∈ J := by
  have ha : (Ideal.Quotient.mk J x) ^ N = 0 := by
    rw [← map_pow]; exact Ideal.Quotient.eq_zero_iff_mem.2 hN
  have hnil : IsNilpotent (LinearMap.mulLeft ℂ (Ideal.Quotient.mk J x)) := by
    refine ⟨N, ?_⟩
    rw [LinearMap.pow_mulLeft, ha, LinearMap.mulLeft_zero_eq_zero]
  have hCH := LinearMap.aeval_self_charpoly (LinearMap.mulLeft ℂ (Ideal.Quotient.mk J x))
  rw [hnil.charpoly_eq_X_pow_finrank, map_pow, Polynomial.aeval_X, LinearMap.pow_mulLeft] at hCH
  have h1 := LinearMap.congr_fun hCH 1
  rw [LinearMap.mulLeft_apply, mul_one, LinearMap.zero_apply] at h1
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_pow]
  exact h1

/-! ## Derivatives of products -/

/-- The product of two differentiable functions vanishing at `p` has zero derivative at `p`. -/
lemma hasFDerivAt_mul_of_eq_zero {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    {f g : E → ℂ} {p : E} (hf : DifferentiableAt ℂ f p) (hg : DifferentiableAt ℂ g p)
    (hf0 : f p = 0) (hg0 : g p = 0) :
    HasFDerivAt (fun x => f x * g x) (0 : E →L[ℂ] ℂ) p := by
  have := hf.hasFDerivAt.mul hg.hasFDerivAt
  refine this.congr_fderiv ?_
  ext v
  simp [hf0, hg0]

end Yau
